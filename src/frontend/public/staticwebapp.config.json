{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "*.svg", "*.png", "*.jpg", "*.jpeg", "*.gif", "*.ico", "*.css", "*.js"]
  },
  "routes": [
    {
      "route": "/scanner",
      "rewrite": "/index.html"
    },
    {
      "route": "/company",
      "rewrite": "/index.html"
    },
    {
      "route": "/generator",
      "rewrite": "/index.html"
    },
    {
      "route": "/analytics",
      "rewrite": "/index.html"
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  }
}

